# GenICam environment setting:
STAPI_ROOT_PATH=/opt/sentech
GENICAM_GENTL64_PATH=/opt/sentech/lib:$GENICAM_GENTL64_PATH
LIBRARY_PATH=$STAPI_ROOT_PATH/lib:$STAPI_ROOT_PATH/lib/GenICam:$LIBRARY_PATH
LD_LIBRARY_PATH=$STAPI_ROOT_PATH/lib:$STAPI_ROOT_PATH/lib/GenICam:$LD_LIBRARY_PATH
export GENICAM_GENTL64_PATH STAPI_ROOT_PATH LIBRARY_PATH LD_LIBRARY_PATH
# Override the default minimal GenTL buffer with STGENTL_MINBUFFER (1..32):
#export STGENTL_MINBUFFER=2
# Override the heartbeat of GigE camera with STGENTL_GIGE_HEARTBEAT [ms]:
#export STGENTL_GIGE_HEARTBEAT=500
