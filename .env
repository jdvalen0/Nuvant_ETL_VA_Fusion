# ═══════════════════════════════════════════════════════════════════════════
# PLC S7 — sustituir PLC_IP por la IP real del PLC
# ═══════════════════════════════════════════════════════════════════════════
PLC_IP=192.168.1.10
PLC_DB=1
PLC_BYTE=0
PLC_BIT=0
PLC_RACK=0
PLC_SLOT=1

# ═══════════════════════════════════════════════════════════════════════════
# CÁMARA GigE — dejar CAMERA_IP vacío para tomar el primer dispositivo (como antes).
# A FUTURO: si cambias la IP de la cámara, define CAMERA_IP y CAMERA_FORCE_IP.
# Ver INSTRUCCIONES_OPERATIVAS.md sección 5.
# ═══════════════════════════════════════════════════════════════════════════
# CAMERA_IP=
# CAMERA_FORCE_IP=169.254.75.178
